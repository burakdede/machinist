[
  // Preserve the familiar explicit save action in every editor mode.
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },
  // Extend Ctrl-W navigation from editor panes to Zed's docks.
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight"
    }
  },
  // Use the common Neovim insert-mode escape chord.
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  // Treat camelCase and snake_case components as individual words.
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd"
    }
  },
  // Match Neovim surround workflows when a visual selection is active.
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds"
    }
  },
  // Match Neovim's default Y behavior: yank from the cursor to end of line.
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  }
]
