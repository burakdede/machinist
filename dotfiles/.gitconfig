[color]
	ui = true
	branch = auto
	status = auto
	interactive = auto
[core]
	# delta gives syntax-highlighted, side-by-side-capable diffs.
	#
	# Guarded on purpose: git treats a missing pager as FATAL ("unable to
	# execute pager"), and this file is symlinked on every machine including
	# ones where the system step has not run yet. The fallback keeps git
	# usable rather than bricking it.
	pager = command -v delta >/dev/null 2>&1 && delta || less -FRX
	excludesfile = ~/.gitignore_global
	editor = nvim
	autocrlf = input
	quotepath = false
	whitespace = trailing-space,space-before-tab,indent-with-non-tab,cr-at-eol

# Best practices for git
[init]
	defaultBranch = main
	templateDir = ~/.git_template

# Git config
[advice]
	# Disable some verbose messages
	addIgnoredFile = false
	addEmbeddedRepo = false
	commitBeforeMerge = false

# Git push
[push]
	# Push the current branch to a branch of the same name.
	default = current
	# Create the upstream branch on first push. `default = current` does NOT
	# do this on its own -- autoSetupRemote is what replaces --set-upstream.
	autoSetupRemote = true
	# Auto follow tags
	followTags = true

# delta -- syntax-highlighting pager. Ignored entirely when delta is absent.
[delta]
	navigate     = true      # n / N jump between files, as in less
	line-numbers = true
	hyperlinks   = false
	# delta renders through bat, so this is the same theme name bat uses and
	# matches WezTerm and Neovim. Keep the four in step.
	syntax-theme = Dracula
[interactive]
	# Same guard as core.pager above.
	diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only || cat

# Git fetch
[fetch]
	# Drop remote-tracking refs that no longer exist upstream.
	prune = true

# Git pull
[pull]
	# Always rebase instead of merge
	rebase = true

# Reuse recorded conflict resolutions. Worth having with rebase-by-default,
# since the same conflict tends to resurface on every re-rebase.
[rerere]
	enabled = true
	autoUpdate = true

# Git merge
[merge]
	strategy = ort
	# zdiff3 is diff3 with the common lines hoisted out of the conflict body,
	# which makes three-way conflicts considerably easier to read. Git 2.35+.
	conflictstyle = zdiff3

# Git log
#
# NOTE: format.pretty is deliberately NOT set. It applies to `git show` and
# `git whatchanged` as well as `git log`, and a one-line format there hides
# the commit body and author entirely -- `git show <sha>` becomes useless for
# reading why a change was made. Use the `l` / `lg` aliases below for a
# condensed log instead.
[log]
	# Default log format
	date = relative

# Git diff
[diff]
	# Use color
	color = true
	# Highlight moved lines differently from added/removed ones. Pairs with
	# delta, and is useful on its own.
	colorMoved = default
	# NOTE: word-diff is deliberately NOT set globally. It rewrites the hunk
	# body, so `git diff > x.patch` no longer round-trips through `git apply`.
	# Use the `dw` alias below when you want it.

# Git alias (existing section remains unchanged)
[alias]
	# Status and Branch Operations
	st = status
	s = status -s
	br = branch
	co = checkout
	cob = checkout -b
	del = branch -D

	# Log and History
	l = log --oneline --graph
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lgs = log --stat
	lols = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --stat

	# Staging and Commit
	ci = commit
	cm = commit -m
	am = commit --amend
	amn = commit --amend --no-edit
	unstage = reset HEAD --
	undo = reset --soft HEAD~1

	# Push and Pull
	# NOTE: git ignores any alias that shadows a builtin command, so `pull`,
	# `add`, `diff`, `remote` and `tag` cannot be aliased. Where those were
	# defined before they were silently dead; the behaviour they wanted is
	# now either config above (pull.rebase, color.ui) or a short name here.
	pu = push
	# --force-with-lease refuses to clobber commits you have not seen,
	# unlike a bare -f. Use this instead of `push -f`.
	pufo = push --force-with-lease origin

	# Remote and Fetch
	f = fetch
	fa = fetch --all --prune
	rv = remote -v

	# Cleanup
	cleanup = gc --prune=now
	cleanupb = branch --merged | grep -v "^\\*" | xargs -n 1 git branch -d
	cleanf = clean -fd

	# Diff and Compare
	dw = diff --word-diff
	dc = diff --cached
	dh = diff HEAD

	# Stash
	sa = stash
	sap = stash pop
	sal = stash list
	ss = stash show -p

	# Tag
	ta = tag -a
	tagd = tag -d
	tagl = tag -l
# Machine-local identity and overrides -- not committed to the repo.
# Tip: set credential.helper in ~/.gitconfig.local for OS-specific keychain
#   macOS: git config --file ~/.gitconfig.local credential.helper osxkeychain
#   Linux: git config --file ~/.gitconfig.local credential.helper store
# configure/configure.sh writes your name/email here during bootstrap.
[include]
    path = ~/.gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
