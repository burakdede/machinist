########################################################################
# CLI essentials                                                       #
########################################################################
# Adopt apps that are already in /Applications rather than aborting on
# them, so this runs cleanly on a machine that is not strictly fresh.
cask_args adopt: true

brew "cmake"             # native build tool -- needed for many native extensions
brew "coreutils"         # GNU coreutils (gls, gcat, …) -- consistent behaviour vs BSD
brew "curl", link: true  # ensure modern curl overrides system version
brew "findutils"         # GNU find -- more powerful than BSD find
brew "gh"
brew "git-delta"          # syntax-highlighting pager for git, wired up in .gitconfig
brew "git"
brew "git-lfs"           # large-file support; also in the Ubuntu APT list
brew "htop"
brew "imagemagick"
brew "jq"
brew "moreutils"         # sponge, vipe, ts, etc.
brew "nmap"              # network debugging and port scanning
brew "ripgrep"
brew "ffmpeg"            # media transcoding; also in the Ubuntu APT list
brew "actionlint"        # lints GitHub workflows; agents edit these
brew "gitleaks"          # secret scanning, enforced via pre-commit
brew "shellcheck"
brew "watchexec"         # rerun tests on save; the red-green-refactor loop
brew "tree-sitter-cli"   # required by nvim-treesitter (main branch) to build parsers
brew "tmux"
brew "wget"              # also in the Ubuntu APT list
brew "zsh"

########################################################################
# Modern CLI tools (battle-tested, high daily value)                  #
########################################################################
brew "bash"    # macOS ships bash 3.2 (2007); SDKMAN and mapfile need >= 4
brew "bat"     # cat with syntax highlighting and git diff integration
brew "eza"     # ls replacement -- tree view, git status, icons
brew "fd"      # find replacement -- faster, simpler syntax
brew "fzf"     # fuzzy finder -- shell history, file search, ctrl-r
brew "yq"      # YAML/JSON/TOML processor -- used in CI and dotfile automation
brew "zoxide"  # cd replacement -- wired over `cd` itself in .zshrc, see docs/shell.md
# Benchmarking belongs here rather than in a dev-only list: docs/shell.md quotes
# startup figures to the millisecond and --verify fails the install on a
# regression. Timing that by hand has a noise floor wide enough to swallow the
# differences those numbers assert, so the claims need a tool that does warmup
# runs and outlier detection.
brew "hyperfine"

########################################################################
# Runtime and package management                                       #
########################################################################
# NOTE: mise is deliberately NOT installed from Homebrew. It is installed to
# ~/.local/bin/mise by system.sh, the same path Ubuntu uses, so the single
# activation line in .zshrc/.zprofile works on both platforms. A Homebrew mise
# would satisfy `command -v mise` while leaving that path empty.
brew "uv"      # Python package manager -- replaces pip/venv/pyenv

########################################################################
# Agentic engineering productivity                                     #
########################################################################
brew "direnv"  # per-directory env vars -- agents cd in and env is set automatically
brew "just"    # task runner -- cleaner than Makefiles, agents call `just <task>`
brew "shfmt"   # shell formatter -- agents write shell; keeps it well-formatted

########################################################################
# Apple platform toolchain (macOS only)                                #
########################################################################
# Xcode itself is not installable from here -- it comes from the App Store,
# and `xcode-select --install` provides the command line tools. Everything
# below is the layer on top that both you and the agents drive.
#
# XcodeBuildMCP is deliberately absent: it runs as `npx -y xcodebuildmcp@latest`
# from the MCP client config, so there is nothing for a package manager to own.
# It shells out to the tools below, which is why they belong in the manifest
# even though nothing in this repo calls them directly.
brew "xcbeautify"          # formats xcodebuild output -- raw output is thousands of
                           # DerivedData path lines; agents pay for every one of them
brew "swiftlint"           # lint
brew "swiftformat"         # format -- the pair agents reach for after editing Swift
brew "xcode-build-server"  # SourceKit-LSP for a non-Xcode editor; this is what makes
                           # neovim useful in a Swift project
brew "xcodes"              # installs and switches Xcode versions from the CLI
brew "ipatool"             # App Store package tooling
brew "asc"                 # App Store Connect CLI

########################################################################
# Cloud CLIs                                                           #
########################################################################
# NOTE: wrangler is deliberately NOT here, and not in npm-packages.txt either.
# Its version is coupled to each Worker's compatibility date and bindings, so
# it belongs in the project's own package.json. Use `npx wrangler`. This is the
# same reasoning that keeps project dependencies out of the global npm list.
#
# Linux counterparts: cloudflared and hcloud come from github-tools.txt;
# awscli and gcloud from vendor installers in linux/system/system.sh, since
# neither ships a GitHub release and Ubuntu's awscli package is still v1.
brew "cloudflared"   # Cloudflare Tunnel -- a machine-level daemon, unlike wrangler
brew "awscli"
brew "hcloud"        # Hetzner Cloud

########################################################################
# Apps                                                                 #
########################################################################
cask "alfred"
cask "docker-desktop"            # includes docker CLI and compose. Local databases
                                 # are containers started from a project's compose
                                 # file -- no standalone database server is installed
                                 # by this repo, deliberately.
cask "firefox"
cask "gcloud-cli"                # renamed from google-cloud-sdk; auto-updates itself
cask "google-chrome"
cask "jetbrains-toolbox"
cask "font-jetbrains-mono-nerd-font"  # required by WezTerm + neovim UI icons
cask "maccy"                     # clipboard manager
cask "rectangle"                 # window management
cask "slack"
cask "spotify"
cask "stats"                     # menubar system monitor
cask "the-unarchiver"
cask "wezterm"                   # primary terminal emulator
cask "whatsapp"
