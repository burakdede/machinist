# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo
*~

# Zed's local prompt library database is generated runtime state
dotfiles/.config/zed/prompts/

# Agent scratch memory -- not committed; each machine populates its own
dotfiles/.config/agents/memory/*
!dotfiles/.config/agents/memory/.gitkeep

# Vendored agent skills. Claude Code loads skills from ~/.claude/skills and
# from its own plugin cache, NOT from ~/.config/agents/skills, so anything
# that lands here is dead weight and is regenerated by the plugin cache
# anyway. Guard against it being committed if it reappears.
dotfiles/.config/agents/skills/

# Compiled / cached zsh plugin bundles -- regenerated on first shell launch
dotfiles/.zsh_plugins.zsh
dotfiles/.zsh_plugins.clean.txt

# zsh byte-compiled configs, rebuilt automatically whenever the source changes
*.zwc

# Python
__pycache__/
*.pyc
.pytest_cache/
